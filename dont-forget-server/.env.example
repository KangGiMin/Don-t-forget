MONGO_URI=
# Generate using Node crypto randomBytes(32) encoded as base64url.
JWT_SECRET=
SMTP_USER=
SMTP_PASS=
CONTACT_TO=

FIREBASE_PROJECT_ID=

PORT=3000
DNS_SERVERS=8.8.8.8,8.8.4.4

# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com

# Social OAuth callbacks must be public HTTPS URLs registered in each provider console.
SOCIAL_AUTH_PUBLIC_URL=https://api.example.com
SOCIAL_WEB_RETURN_URL=https://app.example.com/login
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_CALLBACK_URL=https://api.example.com/api/auth/social/naver/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=https://api.example.com/api/auth/social/kakao/callback

# Firebase service-account credentials are server-only. Keep the private key out of source control.
FIREBASE_SERVICE_ACCOUNT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Comma-separated exact Expo Go hostnames allowed for mobile OAuth callbacks (e.g. 192.168.0.28,localhost).
SOCIAL_MOBILE_EXPO_HOSTS=
